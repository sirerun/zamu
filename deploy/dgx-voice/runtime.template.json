{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "zati-voice-runtime-20261014-a"
  },
  "spec": {
    "restartPolicy": "Always",
    "containers": [
      {
        "name": "speech",
        "image": "nvcr.io/nvidia/pytorch@sha256:8014e4ffc674ae9cc9aecad04b64b29c3d311ed738e54ac3042d2d45690d19e9",
        "command": [
          "python",
          "-u",
          "/source/supervise.py"
        ],
        "resources": {
          "limits": {
            "cpu": "4",
            "memory": "6Gi"
          }
        },
        "ports": [
          {
            "containerPort": 8794,
            "hostPort": 18792
          },
          {
            "containerPort": 8092,
            "hostPort": 18092
          }
        ],
        "volumeMounts": [
          {
            "name": "source",
            "mountPath": "/source",
            "readOnly": true
          },
          {
            "name": "prepared",
            "mountPath": "/prepared",
            "readOnly": true
          },
          {
            "name": "anna",
            "mountPath": "/models",
            "readOnly": true
          },
          {
            "name": "packages",
            "mountPath": "/deps",
            "readOnly": true
          },
          {
            "name": "credentials",
            "mountPath": "/credentials",
            "readOnly": true
          }
        ]
      }
    ],
    "volumes": [
      {
        "name": "source",
        "hostPath": {
          "path": "${VOICE_ROOT}/source"
        }
      },
      {
        "name": "prepared",
        "hostPath": {
          "path": "${PREPARED_ROOT}"
        }
      },
      {
        "name": "anna",
        "hostPath": {
          "path": "${PREPARED_ROOT}/anna"
        }
      },
      {
        "name": "packages",
        "hostPath": {
          "path": "${POCKET_PACKAGES}"
        }
      },
      {
        "name": "credentials",
        "hostPath": {
          "path": "${VOICE_ROOT}/credentials"
        }
      }
    ]
  }
}
